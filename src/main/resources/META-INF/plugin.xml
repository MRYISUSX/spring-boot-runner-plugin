<!--
  Plugin Configuration File
  Documentation: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html
-->
<idea-plugin>
    <id>com.github.mryisusx.customspringbootrunner</id>

    <name>Custom Spring Boot WAR Runner</name>

    <vendor email="" url="https://github.com/mryisusx">
        MrYisusX
    </vendor>

    <version>1.0.0</version>

    <description><![CDATA[
        Custom Spring Boot Runner allows you to run Spring Boot projects
        packaged as WAR directly from IntelliJ.

        It simplifies execution of custom WAR-based Spring Boot configurations
        without manual run configuration setup.
    ]]></description>

    <change-notes><![CDATA[
        1.0.0
        - Initial release
        - Support for running WAR-based Spring Boot projects
        - Custom run configuration type
        - Tool window integration
    ]]></change-notes>

    <!-- Minimum compatible IntelliJ build -->
    <idea-version since-build="232" until-build=""/>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool Window -->
        <toolWindow
                id="Custom Spring Boot Runner"
                factoryClass="com.github.mryisusx.springbootrunner.toolWindow.MyToolWindowFactory"
                anchor="right"
                />

        <!-- Project Startup Activity -->
        <postStartupActivity
                implementation="com.github.mryisusx.springbootrunner.startup.MyProjectActivity"/>

        <!-- Custom Run Configuration -->
        <configurationType
                implementation="com.github.mryisusx.springbootrunner.CustomBootConfigurationType"/>

    </extensions>

</idea-plugin>